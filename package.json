{
  "name": "imessage-pdf",
  "version": "0.1.2",
  "description": "Browse local iMessage history and export conversations as printable books.",
  "author": "Drew Hirschi",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev NODE_OPTIONS=--experimental-sqlite next dev --turbopack",
    "build": "NODE_OPTIONS=--experimental-sqlite next build --turbopack",
    "start": "NODE_OPTIONS=--experimental-sqlite next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "electron:prepare": "NODE_OPTIONS=--experimental-sqlite next build --turbopack && node electron/prepareStandalone.js",
    "electron:start": "electron .",
    "electron:dev": "pnpm run electron:prepare && electron .",
    "electron:runtime": "node electron/prepareNodeRuntime.js",
    "electron:build": "pnpm run electron:runtime && pnpm run electron:prepare && ELECTRON_CACHE=${ELECTRON_CACHE:-/tmp/imessage-pdf-electron-cache} electron-builder --mac dmg --arm64",
    "electron:build:linux": "pnpm run electron:prepare && electron-builder --linux dir",
    "electron:build:mac": "pnpm run electron:build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-pdf/renderer": "^4.3.1",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/heic-convert": "^2.1.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.21",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.42.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intersection-observer": "^9.16.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-infinite-scroll-component": "^4.2.5",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "tailwindcss": "^3.4.18",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "electron",
      "esbuild"
    ]
  }
}
